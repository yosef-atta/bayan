# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Bayan API"
API_V1_STR="/api/v1"

# PostgreSQL (Local Docker)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bayan
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bayan

# Redis (Local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
